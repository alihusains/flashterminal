  "cards": [
    {
      "dot": "cyan",
      "title": "Threading & ownership",
      "items": [
        "UI thread exclusively owns TerminalState and the Renderer",
        "Reader thread parses into compact events; no shared mutable grid",
        "Bounded channel: backpressure instead of unbounded queues",
        "Renderer reads RenderSnapshot + dirty rows; never mutates state"
      ]
    },
    {
      "dot": "emerald",
      "title": "Crates",
      "items": [
        "terminal-core: packed 16 B cells, Unicode clusters, snapshot + selection",
        "terminal-parser (vte) · pty (portable-pty)",
        "terminal-text (fontdue) → LRU glyph cache",
        "terminal-renderer (wgpu) · terminal-session hub · desktop (winit)"
      ]
    },
    {
      "dot": "rose",
      "title": "Target budgets",
      "items": [
        "Input latency p95 < 8 ms",
        "Render latency p95 < 16 ms",
        "Idle RAM < 40 MB · startup < 250 ms"
      ]
    }
  ]
